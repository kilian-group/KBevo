# KBevo cluster + path configuration.
#
# Copy this file to `configs/cluster.env` and fill in the values below.
# `cluster.env` is git-ignored — safe for site-specific paths and secrets.
#
#   cp configs/cluster.env.example configs/cluster.env
#   $EDITOR configs/cluster.env
#
# The wrappers `source configs/cluster.env` on their own; you do not need to
# source it manually before running them.
#
# Every variable has a sensible default when left EMPTY (not commented out) —
# the fields below are pre-wired so you only need to fill in the values that
# matter for your site. Leave the empty ones alone if they don't apply.

# ── Conda environment ────────────────────────────────────────────────────────
# Name of the conda env created from environment.yml.
export KBEVO_ENV=kbevo

# ── SLURM resources (only read by scripts/submit_slurm.sh) ───────────────────
# The canonical training / eval scripts (train_sft.sh, train_grpo.sh,
# eval_kbevo.sh, kbevo_hf_smoke.slurm) are scheduler-agnostic and can be run
# directly with bash on any machine — SLURM is entirely optional. When you
# DO submit through `scripts/submit_slurm.sh`, the variables below are
# translated into sbatch command-line flags so you never need to repeat
# --partition / --account / --gres on every submission.
#
# An empty value omits that sbatch flag (falls back to the site default).
# Fill in only what you need; leave the rest empty.
export SLURM_PARTITION=              # e.g. gpu  OR  a comma-list you have ACL access to
export SLURM_ACCOUNT=                # e.g. your project account
export SLURM_QOS=                    # e.g. normal
export SLURM_CONSTRAINT=             # e.g. h100  (site-dependent node feature)
export SLURM_TIME=03:00:00           # walltime; e.g. 03:00:00 or 1-00:00:00

# GRES per workflow. GRES names differ per site — check with `sinfo -o '%G'`.
#   plain-gpu sites   → gpu:1  /  gpu:4
#   named-GPU sites   → gpu:nvidia_h100_nvl:1  /  gpu:nvidia_b200:4  /  gpu:nvidia_rtx_a6000:1
# SFT typically needs 1 GPU. Paper GRPO uses 4× B200; a 2-GPU H100 debug run also works.
export SLURM_SFT_GRES=gpu:1
export SLURM_GRPO_GRES=gpu:4
export SLURM_EVAL_GRES=gpu:1

# ── Checkpoint roots ─────────────────────────────────────────────────────────
# Where SFT/GRPO writes its output checkpoints.
export KBEVO_CKPT_ROOT=$HOME/kbevo_ckpts

# Optional: default SFT dataset path (JSON from kilian-group/KBevo-SFT-hotpotqa-6k).
# Set this once and you can omit --dataset_path from every `train_sft.sh` invocation.
# export KBEVO_SFT_DATA=data/sft/trajectories.json

# Where to find the four released KBevo checkpoints locally. When set, the
# eval / GRPO wrappers skip the HF snapshot_download step.
#
#   $KBEVO_RELEASED_CKPTS/sft_1.7b/checkpoint-368   ← Qwen3-1.7B SFT
#   $KBEVO_RELEASED_CKPTS/sft_4b/checkpoint-735     ← Qwen3-4B   SFT
#   $KBEVO_RELEASED_CKPTS/grpo_1.7b/checkpoint-500  ← Qwen3-1.7B GRPO
#   $KBEVO_RELEASED_CKPTS/grpo_4b/checkpoint-500    ← Qwen3-4B   GRPO
#
# Or override each individually below.
# export KBEVO_RELEASED_CKPTS=/path/to/kbevo_released
# export KBEVO_SFT_1_7B_CKPT=$KBEVO_RELEASED_CKPTS/sft_1.7b/checkpoint-368
# export KBEVO_SFT_4B_CKPT=$KBEVO_RELEASED_CKPTS/sft_4b/checkpoint-735

# ── Weights & Biases ─────────────────────────────────────────────────────────
# Fill in both to enable W&B logging; leave both empty to disable (equivalent
# to WANDB_MODE=disabled).
export WANDB_ENTITY=
export WANDB_PROJECT=

# ── GRPO variants / ablations (scripts/grpo_variants/) ──────────────────────
# Required only if you run the corresponding non-canonical wrapper. See
# scripts/grpo_variants/README.md for what each ablation tests.
#
# One-phase ablation (train_one_phase.slurm)
#   * A 1-phase SFT checkpoint (single-response supervision, no phase-1 KB).
#     This checkpoint is NOT part of the paper's public release.
#   * The Gemini-extracted HotpotQA database JSON that the paper's Phase-1
#     rollouts otherwise produce on the fly. Also NOT part of the release.
# export KBEVO_ONE_PHASE_SFT_1_7B_CKPT=/path/to/qwen3-1.7b-sft-1phase
# export KBEVO_ONE_PHASE_DB=/path/to/hotpotqa_gemini_db.json

# Curriculum / tier-filtering ablation (train_curriculum.slurm)
#   Per-example rollout-success tier scores over the full HotpotQA train set.
#   NOT part of the release.
# export KBEVO_TIER_PATH=/path/to/hotpotqa_train_tier_scores.json
